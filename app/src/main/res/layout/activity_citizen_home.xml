<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESQ LINK"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OFFLINE EMERGENCY COMMUNICATION"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvHoldInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOLD FOR 2 SECONDS"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_light_error"
        app:layout_constraintBottom_toTopOf="@id/tvMisuseWarning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvMisuseWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WARNING: FALSE ALERTS ARE PUNISHABLE BY LAW"
        android:textSize="12sp"
        android:textColor="?attr/colorError"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnSOS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSOS"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="SOS"
        android:textSize="48sp"
        android:textStyle="bold"
        app:cornerRadius="100dp"
        app:backgroundTint="@color/md_theme_light_error"
        android:contentDescription="Send Emergency SOS Alert"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <ProgressBar
        android:id="@+id/progressSOS"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btnSOS"
        app:layout_constraintBottom_toBottomOf="@id/btnSOS"
        app:layout_constraintStart_toStartOf="@id/btnSOS"
        app:layout_constraintEnd_toEndOf="@id/btnSOS" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManage2G"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage 2G Contacts"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:layout_constraintBottom_toTopOf="@+id/llStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/llStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimaryContainer"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS: ● READY"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHubStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMERGENCY HUB: ● NOT CONNECTED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNetworkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NETWORK: ● OFFLINE MODE"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
